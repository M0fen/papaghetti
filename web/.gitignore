# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cerebro — estado local del catálogo (se regenera desde la semilla)
/data/catalog.json
# Respaldos del catalogo: son estado local, no codigo.
/data/respaldo-*.json
/data/*.antes-de-la-carta
/data/*.qa-*

.vercel
.env*
# La plantilla SÍ va al repositorio: dice qué variables existen, sin ningún secreto.
!.env.example
qa-*.sh
