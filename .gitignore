# artefactos locales de QA visual (capturas/Playwright) y respaldos de assets
web/qa-*.mjs
# ...salvo las suites que protegen el dinero y la operación. Vivían en un solo disco
# duro y `npm test` las invocaba igual: pasaban aquí y fallarían en cualquier copia
# limpia. Lo que cubre un error que se come plata tiene que estar versionado.
!web/qa-ts.mjs
!web/qa-dominio.mjs
!web/qa-pedidos.mjs
!web/qa-comanda.mjs
!web/qa-despensa.mjs
!web/qa-comprobantes.mjs
!web/qa-escpos.mjs
